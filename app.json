{
  "expo": {
    "name": "Recordar",
    "slug": "recordar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para o seu perfil no Recordar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "com.recordar.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "icon": "./assets/recordar-icon.png",
    "web": {
      "favicon": "./assets/recordar-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "369b0751-e71b-4f62-8423-a89e4a89911e"
      }
    }
  }
}
