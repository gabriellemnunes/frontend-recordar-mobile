{
  "expo": {
    "name": "Recordar",
    "slug": "recordar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para o seu perfil no Recordar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "com.recordar.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "ios": {
      "supportsTablet": true
    },
    "icon": "./assets/recordar-icon.png",
    "web": { "favicon": "./assets/recordar-icon.png" }
  }
}
